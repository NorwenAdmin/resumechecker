server {
    listen 443 ssl;
    server_name checker.norwen.nl;

    ssl_certificate /etc/letsencrypt/live/norwen.nl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/norwen.nl/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 20M;
        # Resume generation makes two sequential Claude calls (generate + score) and can run
        # well past nginx's 60s default before responding — give it real headroom.
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }
}

server {
    listen 80;
    server_name checker.norwen.nl;
    return 301 https://$host$request_uri;
}
